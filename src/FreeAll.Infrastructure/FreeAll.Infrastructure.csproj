<Project Sdk="Microsoft.NET.Sdk">

  <!-- SQLite persistence, Windows API adapters, logging, configuration and update infrastructure. -->

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- Source-generated P/Invoke for the Recycle Bin size query. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FreeAll.Integration.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="PdfPig" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Persistence/Migrations/Scripts/*.sql" LogicalName="FreeAll.Migrations.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../FreeAll.Core/FreeAll.Core.csproj" />
    <ProjectReference Include="../FreeAll.Application/FreeAll.Application.csproj" />
  </ItemGroup>

</Project>
