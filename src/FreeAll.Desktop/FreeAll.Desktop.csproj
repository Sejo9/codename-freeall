<Project Sdk="Microsoft.NET.Sdk">

  <!-- WPF views, view models, navigation, theme and composition root. -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>FreeAll</AssemblyName>
    <RootNamespace>FreeAll.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- English is the only language in v1; resources added later fall back to it (TD-051). -->
    <NeutralLanguage>en</NeutralLanguage>
    <!-- WPF0001: Application.ThemeMode (Fluent theme) is marked experimental; adopted under TD-011. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FreeAll.Desktop.Tests" />
  </ItemGroup>

  <!-- The helper's digest, passed in by build.ps1 at publish: the app refuses to start any other helper (DEC-025). -->
  <ItemGroup Condition="'$(HelperSha256)' != ''">
    <AssemblyMetadata Include="HelperSha256" Value="$(HelperSha256)" />
  </ItemGroup>

  <!-- The update source and the project's update public key, passed in by build.ps1 for release builds (TD-050). -->
  <ItemGroup Condition="'$(UpdateManifestUrl)' != '' And '$(UpdatePublicKey)' != ''">
    <AssemblyMetadata Include="UpdateManifestUrl" Value="$(UpdateManifestUrl)" />
    <AssemblyMetadata Include="UpdatePublicKey" Value="$(UpdatePublicKey)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../FreeAll.Core/FreeAll.Core.csproj" />
    <ProjectReference Include="../FreeAll.Application/FreeAll.Application.csproj" />
    <ProjectReference Include="../FreeAll.Scanner/FreeAll.Scanner.csproj" />
    <ProjectReference Include="../FreeAll.Residue/FreeAll.Residue.csproj" />
    <ProjectReference Include="../FreeAll.Duplicates/FreeAll.Duplicates.csproj" />
    <ProjectReference Include="../FreeAll.Cleanup/FreeAll.Cleanup.csproj" />
    <ProjectReference Include="../FreeAll.Infrastructure/FreeAll.Infrastructure.csproj" />
  </ItemGroup>

</Project>
