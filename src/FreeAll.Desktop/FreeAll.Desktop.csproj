    <ProjectReference Include="../FreeAll.Residue/FreeAll.Residue.csproj" />
    <ProjectReference Include="../FreeAll.Duplicates/FreeAll.Duplicates.csproj" />
    <ProjectReference Include="../FreeAll.Cleanup/FreeAll.Cleanup.csproj" />
    <ProjectReference Include="../FreeAll.Infrastructure/FreeAll.Infrastructure.csproj" />
  </ItemGroup>

</Project>
