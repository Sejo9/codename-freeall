<Window x:Class="FreeAll.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:FreeAll.Desktop.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:FreeAll.Desktop.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ShellViewModel}"
        x:ClassModifier="internal"
        Title="FreeAll"
        Width="1280"
        Height="800"
        MinWidth="720"
        MinHeight="520"
        WindowStartupLocation="CenterScreen">

  <Window.InputBindings>
    <KeyBinding Key="F" Modifiers="Control" Command="{Binding FocusSearchCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
  </Window.InputBindings>

  <Grid x:Name="RootLayout" Background="{DynamicResource Color.Background}" TextElement.FontFamily="{StaticResource Font.Text}">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Navigation rail -->
    <DockPanel x:Name="NavigationPane" Grid.Row="0" Grid.Column="0">
      <DockPanel.Style>
        <Style TargetType="DockPanel">
          <Setter Property="Width" Value="{StaticResource Nav.ExpandedWidth}" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsNavigationExpanded}" Value="False">
              <Setter Property="Width" Value="{StaticResource Nav.CompactWidth}" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </DockPanel.Style>

      <StackPanel Margin="6,8,4,8" DockPanel.Dock="Top" Orientation="Horizontal">
        <Button AutomationProperties.Name="Expand or collapse navigation"
                Command="{Binding ToggleNavigationCommand}"
                Style="{StaticResource Button.Icon}"
                ToolTip="Expand or collapse navigation">
          <controls:Glyph Style="{StaticResource Typography.Icon}" Text="&#xE700;" />
        </Button>
        <TextBlock Margin="12,0,0,0"
                   VerticalAlignment="Center"
                   Style="{StaticResource Typography.Title}"
                   Text="FreeAll"
                   Visibility="{Binding IsNavigationExpanded, Converter={StaticResource BoolToVisibility}}" />
      </StackPanel>

      <ListBox x:Name="NavigationList"
               AutomationProperties.Name="Main navigation"
               ItemContainerStyle="{StaticResource Nav.Item}"
               ItemsSource="{Binding NavigationItems}"
               SelectedItem="{Binding SelectedItem}"
               Style="{StaticResource Nav.List}">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:NavigationItem}">
            <StackPanel Height="40" Orientation="Horizontal">
              <controls:Glyph Width="44"
                         Style="{StaticResource Typography.Icon}"
                         Text="{Binding Glyph}"
                         TextAlignment="Center" />
              <TextBlock VerticalAlignment="Center"
                         Style="{StaticResource Typography.Body}"
                         Text="{Binding Title}"
                         TextWrapping="NoWrap"
                         Visibility="{Binding DataContext.IsNavigationExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <!-- Content layer -->
    <Border Grid.Row="0"
            Grid.Column="1"
            Background="{DynamicResource Color.SurfaceElevated}"
            BorderBrush="{DynamicResource Color.Border}"
            BorderThickness="1,1,0,0"
            CornerRadius="8,0,0,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="32,24,32,12">
          <!-- Title region actions: search and the review queue (docs/07-ui-ux-design.md §2). -->
          <StackPanel Margin="16,4,0,0" VerticalAlignment="Top" DockPanel.Dock="Right" Orientation="Horizontal">
            <Grid>
            <TextBox x:Name="HeaderSearch"
                     Width="260"
                     VerticalContentAlignment="Center"
                     AutomationProperties.HelpText="Type part of a file or folder name and press Enter."
                     AutomationProperties.Name="Search file and folder names"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Search file and folder names in the latest scans (Ctrl+F)">
              <TextBox.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
              </TextBox.InputBindings>
            </TextBox>
            <TextBlock Style="{StaticResource Placeholder}" Tag="{Binding ElementName=HeaderSearch}" Text="Search names (Ctrl+F)" />
            </Grid>
            <Button Margin="4,0,0,0" AutomationProperties.Name="Search" Command="{Binding SearchCommand}" Style="{StaticResource Button.Icon}" ToolTip="Search">
              <controls:Glyph FontSize="14" Style="{StaticResource Typography.Icon}" Text="&#xE721;" />
            </Button>
            <Button Margin="12,0,0,0"
                    AutomationProperties.Name="{Binding ReviewQueue.CountText}"
                    Command="{Binding OpenReviewQueueCommand}"
                    ToolTip="Items you set aside to decide about later">
              <StackPanel Orientation="Horizontal">
                <controls:Glyph Margin="0,0,8,0" FontSize="14" Style="{StaticResource Typography.Icon}" Text="&#xE762;" />
                <TextBlock Text="{Binding ReviewQueue.CountText}" />
              </StackPanel>
            </Button>
          </StackPanel>
          <StackPanel>
          <TextBlock AutomationProperties.HeadingLevel="Level1"
                     Style="{StaticResource Typography.Display}"
                     Text="{Binding CurrentPage.Title}" />
          <TextBlock Margin="0,4,0,0"
                     Style="{StaticResource Typography.Caption}"
                     Text="{Binding CurrentPage.Subtitle}"
                     TextWrapping="Wrap"
                     Visibility="{Binding CurrentPage.Subtitle, Converter={StaticResource NullToVisibility}}" />
          </StackPanel>
        </DockPanel>

        <!-- Asked once, at first start, and only when this build can check (PR-018, DEC-019). -->
        <Border Grid.Row="1"
                MaxWidth="1100"
                Margin="32,0,32,12"
                HorizontalAlignment="Left"
                AutomationProperties.Name="Update checks"
                Style="{StaticResource Banner.Info}"
                Visibility="{Binding Updates.ShowFirstRunQuestion, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
          <DockPanel>
            <controls:Glyph Margin="0,2,10,0" VerticalAlignment="Top" DockPanel.Dock="Left" Foreground="{DynamicResource Color.Info}" Style="{StaticResource Typography.Icon}" Text="&#xE895;" />
            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center" DockPanel.Dock="Right" Orientation="Horizontal">
              <Button Command="{Binding Updates.AcceptChecksCommand}" Content="Check for updates" Style="{StaticResource Button.Accent}" />
              <Button Margin="8,0,0,0" Command="{Binding Updates.DeclineChecksCommand}" Content="Don't check" />
            </StackPanel>
            <StackPanel>
              <TextBlock Style="{StaticResource Typography.Title}" Text="Check for FreeAll updates?" />
              <TextBlock Margin="0,2,0,0" Style="{StaticResource Typography.Body}" Text="{Binding Updates.SourceText}" TextWrapping="Wrap" />
              <TextBlock Margin="0,2,0,0" Style="{StaticResource Typography.Caption}" Text="Once a week at most, when FreeAll starts. Updates are never downloaded or installed without asking you. You can change this in Settings." TextWrapping="Wrap" />
            </StackPanel>
          </DockPanel>
        </Border>

        <ContentControl Grid.Row="2" Content="{Binding CurrentPage}" Focusable="False" />
      </Grid>
    </Border>

    <!-- Status region -->
    <Border Grid.Row="1"
            Grid.ColumnSpan="2"
            Padding="16,6"
            Background="{DynamicResource Color.Background}">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Typography.Caption}" Text="{Binding VersionText}" />
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource Typography.Caption}" Text="{Binding ScanActivity.StatusText}" />
          <TextBlock Margin="12,0" Style="{StaticResource Typography.Caption}" Text="·" />
          <StackPanel Orientation="Horizontal" ToolTip="{Binding DatabaseProblem}">
            <controls:Glyph Margin="0,0,6,0"
                       FontSize="12"
                       Foreground="{DynamicResource Color.Success}"
                       Style="{StaticResource Typography.Icon}"
                       Text="&#xE73E;"
                       Visibility="{Binding IsDatabaseReady, Converter={StaticResource BoolToVisibility}}" />
            <controls:Glyph Margin="0,0,6,0"
                       FontSize="12"
                       Foreground="{DynamicResource Color.Danger}"
                       Style="{StaticResource Typography.Icon}"
                       Text="&#xE7BA;"
                       Visibility="{Binding IsDatabaseReady, Converter={StaticResource InverseBoolToVisibility}}" />
            <TextBlock Style="{StaticResource Typography.Caption}" Text="{Binding DatabaseStatusText}" />
          </StackPanel>
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</Window>
