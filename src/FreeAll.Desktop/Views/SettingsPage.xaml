<UserControl x:Class="FreeAll.Desktop.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FreeAll.Desktop.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:FreeAll.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
             x:ClassModifier="internal">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="880" Margin="{StaticResource Thickness.Page}" HorizontalAlignment="Left">

      <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{StaticResource SectionHeader}" Text="Appearance" />
      <Border Margin="{StaticResource Thickness.SectionGap}" Style="{StaticResource Card}">
        <StackPanel>
          <DockPanel>
            <ComboBox x:Name="ThemeChoice"
                      Width="220"
                      VerticalAlignment="Center"
                      AutomationProperties.Name="Theme"
                      DisplayMemberPath="Label"
                      DockPanel.Dock="Right"
                      ItemsSource="{Binding ThemeOptions}"
                      SelectedItem="{Binding SelectedThemeOption}" />
            <StackPanel Margin="0,0,16,0">
              <TextBlock Style="{StaticResource Typography.Body}" Text="Theme" />
              <TextBlock Style="{StaticResource Typography.Caption}" Text="Windows high-contrast themes always take priority." />
            </StackPanel>
          </DockPanel>
          <TextBlock Margin="0,8,0,0"
                     Foreground="{DynamicResource Color.Warning}"
                     Style="{StaticResource Typography.Caption}"
                     Text="{Binding PreferenceNote}"
                     Visibility="{Binding PreferenceNote, Converter={StaticResource NullToVisibility}}" />
        </StackPanel>
      </Border>

      <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{StaticResource SectionHeader}" Text="Scan history" />
      <Border Margin="{StaticResource Thickness.SectionGap}" Style="{StaticResource Card}">
        <StackPanel>
          <DockPanel>
            <ComboBox Width="300"
                      VerticalAlignment="Center"
                      AutomationProperties.Name="Detailed results to keep"
                      DisplayMemberPath="Label"
                      DockPanel.Dock="Right"
                      ItemsSource="{Binding DetailedOptions}"
                      SelectedItem="{Binding SelectedDetailed}" />
            <StackPanel Margin="0,0,16,0">
              <TextBlock Style="{StaticResource Typography.Body}" Text="Detailed results" />
              <TextBlock Style="{StaticResource Typography.Caption}" Text="Every folder and file of a scan, needed to browse it and to compare folders between scans. A drive with a million files needs about 200 MB per scan. The newest complete scan is also kept." TextWrapping="Wrap" />
            </StackPanel>
          </DockPanel>
          <Separator Margin="0,12" />
          <DockPanel>
            <ComboBox Width="300"
                      VerticalAlignment="Center"
                      AutomationProperties.Name="Scan summaries to keep"
                      DisplayMemberPath="Label"
                      DockPanel.Dock="Right"
                      ItemsSource="{Binding HistoryOptions}"
                      SelectedItem="{Binding SelectedHistory}" />
            <StackPanel Margin="0,0,16,0">
              <TextBlock Style="{StaticResource Typography.Body}" Text="Scan summaries" />
              <TextBlock Style="{StaticResource Typography.Caption}" Text="Each scan's totals, categories and errors, used by Scan History and its chart. The newest scan of each drive is always kept." TextWrapping="Wrap" />
            </StackPanel>
          </DockPanel>
          <TextBlock Margin="0,8,0,0"
                     Style="{StaticResource Typography.Caption}"
                     Text="{Binding RetentionNote}"
                     TextWrapping="Wrap"
                     Visibility="{Binding RetentionNote, Converter={StaticResource NullToVisibility}}" />
        </StackPanel>
      </Border>

      <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{StaticResource SectionHeader}" Text="Updates" Visibility="{Binding Updates, Converter={StaticResource NullToVisibility}}" />
      <Border Margin="{StaticResource Thickness.SectionGap}" DataContext="{Binding Updates}" Style="{StaticResource Card}" Visibility="{Binding Converter={StaticResource NullToVisibility}}">
        <StackPanel>
          <DockPanel>
            <ComboBox Width="300"
                      VerticalAlignment="Center"
                      AutomationProperties.Name="Update checks"
                      DisplayMemberPath="Label"
                      DockPanel.Dock="Right"
                      IsEnabled="{Binding IsConfigured}"
                      ItemsSource="{Binding ChoiceOptions}"
                      SelectedItem="{Binding SelectedChoice}" />
            <StackPanel Margin="0,0,16,0">
              <TextBlock Style="{StaticResource Typography.Body}" Text="Update checks" />
              <TextBlock Style="{StaticResource Typography.Caption}" Text="{Binding SourceText}" TextWrapping="Wrap" />
            </StackPanel>
          </DockPanel>
          <WrapPanel Margin="0,12,0,0">
            <Button Margin="0,0,8,4" Command="{Binding CheckNowCommand}" Content="Check now" />
            <Button Margin="0,0,8,4" Command="{Binding DownloadCommand}" Content="Download update" Visibility="{Binding HasAvailable, Converter={StaticResource BoolToVisibility}}" />
            <Button Margin="0,0,8,4" Command="{Binding InstallCommand}" Content="Install update…" Style="{StaticResource Button.Accent}" Visibility="{Binding IsDownloaded, Converter={StaticResource BoolToVisibility}}" />
          </WrapPanel>
          <ProgressBar Height="4" Margin="0,4,0,0" AutomationProperties.Name="Download progress" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
          <TextBlock Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite" Style="{StaticResource Typography.Caption}" Text="{Binding StatusText}" TextWrapping="Wrap" Visibility="{Binding StatusText, Converter={StaticResource NullToVisibility}}" />
          <StackPanel Margin="0,8,0,0" Visibility="{Binding HasAvailable, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Style="{StaticResource Typography.Title}" Text="{Binding AvailableTitle}" />
            <TextBlock Margin="0,4,0,0" Style="{StaticResource Typography.Body}" Text="{Binding AvailableDetails}" TextWrapping="Wrap" />
          </StackPanel>
        </StackPanel>
      </Border>

      <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{StaticResource SectionHeader}" Text="Privacy" />
      <Border Margin="{StaticResource Thickness.SectionGap}" Style="{StaticResource Card}">
        <DockPanel>
          <controls:Glyph Margin="0,2,12,0"
                     VerticalAlignment="Top"
                     DockPanel.Dock="Left"
                     Style="{StaticResource Typography.Icon}"
                     Text="&#xE72E;" />
          <StackPanel>
            <TextBlock Style="{StaticResource Typography.Body}" Text="Everything stays on this PC" />
            <TextBlock Margin="0,4,0,0"
                       Style="{StaticResource Typography.Caption}"
                       Text="FreeAll analyses storage locally. It does not send telemetry, file names, paths, hashes or any other information over the network. The only network use is the update check below, and only if you turn it on; it downloads update information and sends nothing about this PC." />
          </StackPanel>
        </DockPanel>
      </Border>

      <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{StaticResource SectionHeader}" Text="Data storage" />
      <Border Margin="{StaticResource Thickness.SectionGap}" Style="{StaticResource Card}">
        <StackPanel>
          <DockPanel>
            <Button VerticalAlignment="Center"
                    Command="{Binding OpenDataFolderCommand}"
                    Content="Open folder"
                    DockPanel.Dock="Right"
                    AutomationProperties.Name="Open data folder" />
            <StackPanel Margin="0,0,16,0">
              <TextBlock Style="{StaticResource Typography.Body}" Text="Data folder" />
              <TextBox Margin="0,2,0,0" AutomationProperties.Name="Data folder path" Style="{StaticResource SelectableMonospace}" Text="{Binding DataDirectory, Mode=OneTime}" />
            </StackPanel>
          </DockPanel>
          <Separator Margin="0,12" />
          <DockPanel>
            <Button VerticalAlignment="Center"
                    Command="{Binding OpenLogsFolderCommand}"
                    Content="Open folder"
                    DockPanel.Dock="Right"
                    AutomationProperties.Name="Open logs folder" />
            <StackPanel Margin="0,0,16,0">
              <TextBlock Style="{StaticResource Typography.Body}" Text="Logs" />
              <TextBox Margin="0,2,0,0" AutomationProperties.Name="Logs folder path" Style="{StaticResource SelectableMonospace}" Text="{Binding LogsDirectory, Mode=OneTime}" />
              <TextBlock Margin="0,4,0,0" Style="{StaticResource Typography.Caption}" Text="Logs stay on this PC. File and folder names are replaced with short fingerprints." />
            </StackPanel>
          </DockPanel>
          <Separator Margin="0,12" />
          <TextBlock Style="{StaticResource Typography.Body}" Text="Database" />
          <TextBlock Style="{StaticResource Typography.Caption}" Text="{Binding DatabaseStatusText}" />
        </StackPanel>
      </Border>

      <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{StaticResource SectionHeader}" Text="About" />
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Style="{StaticResource Typography.Body}" Text="{Binding DataContext.VersionText, RelativeSource={RelativeSource AncestorType=Window}}" />
          <TextBlock Margin="0,4,0,0" Style="{StaticResource Typography.Caption}" Text="{Binding RuntimeText}" />
          <TextBlock Margin="0,4,0,0" Style="{StaticResource Typography.Caption}" Text="Free to use and share. This build is not code-signed." />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
