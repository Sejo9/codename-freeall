<UserControl x:Class="FreeAll.Desktop.Views.LargeFilesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:index="clr-namespace:FreeAll.Desktop.ViewModels.Index"
             xmlns:views="clr-namespace:FreeAll.Desktop.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=index:LargeFilesViewModel}"
             x:ClassModifier="internal">
  <Grid Margin="{StaticResource Thickness.Page}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Filters -->
    <WrapPanel Grid.Row="0" Margin="0,0,0,8" Visibility="{Binding Drives.Count, Converter={StaticResource NullToVisibility}}">
      <ComboBox MinWidth="110" Margin="0,0,8,8" AutomationProperties.Name="Show" DisplayMemberPath="Label" ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}" />
      <ComboBox MinWidth="280" Margin="0,0,8,8" AutomationProperties.Name="Drive" DisplayMemberPath="Label" ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive}" />
      <ComboBox MinWidth="200"
                Margin="0,0,8,8"
                AutomationProperties.Name="Category"
                DisplayMemberPath="Label"
                IsEnabled="{Binding ShowsFolders, Converter={StaticResource InverseBool}}"
                ItemsSource="{Binding Categories}"
                SelectedItem="{Binding SelectedCategory}" />
      <ComboBox MinWidth="150"
                Margin="0,0,8,8"
                AutomationProperties.Name="Minimum size"
                DisplayMemberPath="Label"
                IsEnabled="{Binding ShowsFolders, Converter={StaticResource InverseBool}}"
                ItemsSource="{Binding MinimumSizes}"
                SelectedItem="{Binding SelectedMinimumSize}" />
    </WrapPanel>

    <DockPanel Grid.Row="1" Margin="0,0,0,8" Visibility="{Binding Drives.Count, Converter={StaticResource NullToVisibility}}">
      <Button Margin="8,0,0,0" Command="{Binding CopyPathCommand}" Content="Copy path" DockPanel.Dock="Right" />
      <Button Margin="8,0,0,0" Command="{Binding RevealCommand}" Content="Open in File Explorer" DockPanel.Dock="Right" />
      <Button Margin="8,0,0,0" Command="{Binding ShowInExplorerCommand}" Content="Show in Storage Explorer" DockPanel.Dock="Right" />
      <StackPanel VerticalAlignment="Center">
        <TextBlock Style="{StaticResource Typography.Caption}" Text="{Binding ResultText}" />
        <TextBlock Style="{StaticResource Typography.Caption}"
                   Text="Folder sizes include everything inside them, so a large folder's parents are listed too. Location is context, not a sign that something is safe to remove."
                   TextWrapping="Wrap" />
      </StackPanel>
    </DockPanel>

    <!-- Empty state -->
    <Border Grid.Row="2"
            MaxWidth="560"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Style="{StaticResource Card}"
            Visibility="{Binding Drives.Count, Converter={StaticResource InverseNullToVisibility}}">
      <StackPanel>
        <TextBlock Style="{StaticResource Typography.Title}" Text="No scan results yet" />
        <TextBlock Margin="0,4,0,12" Style="{StaticResource Typography.Body}" Text="Scan a drive to see its largest files and folders here." />
        <Button HorizontalAlignment="Left" Command="{Binding GoToDrivesCommand}" Content="Go to Drives" Style="{StaticResource Button.Accent}" />
      </StackPanel>
    </Border>

    <Grid Grid.Row="2" Visibility="{Binding Drives.Count, Converter={StaticResource NullToVisibility}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <Border Padding="0" Style="{StaticResource Card}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <ProgressBar AutomationProperties.Name="Loading" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
          <DataGrid Grid.Row="1"
                    AutomationProperties.Name="Largest items"
                    CanUserSortColumns="False"
                    ItemsSource="{Binding Results}"
                    SelectedItem="{Binding SelectedRow}"
                    AutoGenerateColumns="False"
                    BorderThickness="0"
                    CanUserReorderColumns="True"
                    CanUserResizeColumns="True"
                    EnableColumnVirtualization="True"
                    EnableRowVirtualization="True"
                    GridLinesVisibility="None"
                    HeadersVisibility="Column"
                    IsReadOnly="True"
                    SelectionMode="Single"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.ScrollUnit="Item"
                    VirtualizingPanel.VirtualizationMode="Recycling">
            <DataGrid.Columns>
              <DataGridTemplateColumn Width="*" MinWidth="200" Header="Name">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate DataType="{x:Type index:IndexRowViewModel}">
                    <StackPanel Orientation="Horizontal" ToolTip="{Binding FullPath}">
                      <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" FontSize="14" Style="{StaticResource Icon.Entry}" Text="{Binding Glyph}" />
                      <TextBlock VerticalAlignment="Center" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Width="100" MinWidth="100" Binding="{Binding LogicalSize, Converter={StaticResource ByteSize}}" ElementStyle="{StaticResource Cell.Numeric}" Header="Size" />
              <DataGridTextColumn Width="100" MinWidth="100" Binding="{Binding AllocatedSize, Converter={StaticResource ByteSize}}" ElementStyle="{StaticResource Cell.Numeric}" Header="On disk" />
              <DataGridTextColumn Width="160" MinWidth="160" Binding="{Binding CategoryText}" ElementStyle="{StaticResource Cell.Secondary}" Header="Category" />
              <DataGridTextColumn Width="130" MinWidth="130" Binding="{Binding LocationText}" ElementStyle="{StaticResource Cell.Secondary}" Header="Location" />
              <DataGridTextColumn ElementStyle="{StaticResource Cell.Secondary}" Width="150" MinWidth="150" Binding="{Binding Modified, StringFormat=g}" Header="Modified" />
              <DataGridTextColumn Width="320" MinWidth="200" Binding="{Binding FolderPath}" ElementStyle="{StaticResource Cell.Secondary}" Header="In folder" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>

      <Border Grid.Column="1" Width="320" Margin="12,0,0,0" Style="{StaticResource Card}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <views:EntryInspector DataContext="{Binding Details}" />
        </ScrollViewer>
      </Border>
    </Grid>

    <Border Grid.Row="2"
            MaxWidth="640"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Style="{StaticResource Banner.Warning}"
            Visibility="{Binding State, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Error}">
      <StackPanel>
        <TextBlock Style="{StaticResource Typography.Title}" Text="Scan results couldn't be read" />
        <TextBlock Margin="0,4,0,8" Style="{StaticResource Typography.Body}" Text="{Binding ErrorMessage}" />
        <Button HorizontalAlignment="Left" Command="{Binding ReloadCommand}" Content="Try again" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
