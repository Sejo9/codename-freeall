<UserControl x:Class="FreeAll.Desktop.Views.ExplorerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:index="clr-namespace:FreeAll.Desktop.ViewModels.Index"
             xmlns:views="clr-namespace:FreeAll.Desktop.Views"
             xmlns:controls="clr-namespace:FreeAll.Desktop.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=index:ExplorerViewModel}"
             x:ClassModifier="internal">
  <Grid Margin="{StaticResource Thickness.Page}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Drive selector and actions -->
    <DockPanel Grid.Row="0" Margin="0,0,0,12" Visibility="{Binding Sessions.Count, Converter={StaticResource NullToVisibility}}">
      <Button Margin="8,0,0,0" Command="{Binding ToggleInspectorCommand}" DockPanel.Dock="Right">
        <Button.Style>
          <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Content" Value="Hide details" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsInspectorOpen}" Value="False">
                <Setter Property="Content" Value="Show details" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Button.Style>
      </Button>
      <Button Margin="8,0,0,0" Command="{Binding ExportCommand}" Content="Export…" DockPanel.Dock="Right" ToolTip="Save everything in this folder as CSV, JSON, HTML or PDF" />
      <Button Margin="8,0,0,0" Command="{Binding AddToReviewCommand}" Content="Add to review queue" DockPanel.Dock="Right" ToolTip="Set the selected items aside to decide about later. Nothing is changed or removed." />
      <Button Margin="8,0,0,0" Command="{Binding CopyPathCommand}" Content="Copy path" DockPanel.Dock="Right" />
      <Button Margin="8,0,0,0" Command="{Binding RevealCommand}" Content="Open in File Explorer" DockPanel.Dock="Right" />
      <ToggleButton Margin="8,0,0,0"
                    AutomationProperties.Name="Show as treemap"
                    DockPanel.Dock="Right"
                    IsChecked="{Binding IsTreemap}"
                    ToolTip="Show the folder as a treemap: each tile's area is its size on disk">
        <StackPanel Orientation="Horizontal">
          <controls:Glyph Margin="0,0,8,0" FontSize="14" Style="{StaticResource Typography.Icon}" Text="&#xE80A;" />
          <TextBlock Text="Treemap" />
        </StackPanel>
      </ToggleButton>
      <ComboBox MinWidth="300"
                HorizontalAlignment="Left"
                AutomationProperties.Name="Drive scan to browse"
                DisplayMemberPath="Label"
                ItemsSource="{Binding Sessions}"
                SelectedItem="{Binding SelectedSession}" />
    </DockPanel>

    <!-- Partial-scan notice: says why totals may be low -->
    <Border Grid.Row="1"
            Margin="0,0,0,12"
            Style="{StaticResource Banner.Warning}"
            Visibility="{Binding SelectedSession.IsPartial, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
      <DockPanel>
        <controls:Glyph Margin="0,0,10,0" DockPanel.Dock="Left" Foreground="{DynamicResource Color.Warning}" Style="{StaticResource Typography.Icon}" Text="&#xE7BA;" />
        <TextBlock Style="{StaticResource Typography.Body}">
          <Run FontWeight="SemiBold" Text="This scan is partial." />
          <Run Text="{Binding SelectedSession.Session.Note, Mode=OneWay}" />
        </TextBlock>
      </DockPanel>
    </Border>

    <!-- Breadcrumbs -->
    <DockPanel Grid.Row="2" Margin="0,0,0,8" Visibility="{Binding CurrentFolder, Converter={StaticResource NullToVisibility}}">
      <Button Margin="0,0,8,0"
              AutomationProperties.Name="Up one level"
              Command="{Binding UpCommand}"
              DockPanel.Dock="Left"
              Style="{StaticResource Button.Icon}"
              ToolTip="Up one level">
        <controls:Glyph FontSize="14" Style="{StaticResource Typography.Icon}" Text="&#xE74A;" />
      </Button>
      <TextBlock Margin="12,0,0,0"
                 VerticalAlignment="Center"
                 DockPanel.Dock="Right"
                 Style="{StaticResource Typography.Caption}">
        <Run Text="{Binding StatusMessage, Mode=OneWay}" />
        <Run Text="{Binding CountText, Mode=OneWay}" />
      </TextBlock>
      <ItemsControl VerticalAlignment="Center" AutomationProperties.Name="Path" Focusable="False" ItemsSource="{Binding Breadcrumbs}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type index:IndexRowViewModel}">
            <StackPanel Orientation="Horizontal">
              <controls:Glyph Margin="2,0" VerticalAlignment="Center" FontSize="10" Foreground="{DynamicResource Color.TextSecondary}" Style="{StaticResource Typography.Icon}" Text="&#xE76C;" />
              <Button Padding="6,2"
                      Command="{Binding DataContext.NavigateBreadcrumbCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                      CommandParameter="{Binding}"
                      Content="{Binding Name}"
                      Background="Transparent"
                      BorderThickness="0" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </DockPanel>

    <!-- Empty state: nothing scanned yet -->
    <Border Grid.Row="3"
            MaxWidth="560"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Style="{StaticResource Card}"
            Visibility="{Binding Sessions.Count, Converter={StaticResource InverseNullToVisibility}}">
      <StackPanel>
        <TextBlock Style="{StaticResource Typography.Title}" Text="No scan results yet" />
        <TextBlock Margin="0,4,0,12" Style="{StaticResource Typography.Body}" Text="Scan a drive to browse its folders and files here, with the size of everything inside each folder." />
        <Button HorizontalAlignment="Left" Command="{Binding GoToDrivesCommand}" Content="Go to Drives" Style="{StaticResource Button.Accent}" />
      </StackPanel>
    </Border>

    <Grid Grid.Row="3" Visibility="{Binding Sessions.Count, Converter={StaticResource NullToVisibility}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="260" MinWidth="160" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="*" MinWidth="300" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Padding="4" Style="{StaticResource Card}">
        <TreeView AutomationProperties.Name="Folders"
                  Background="Transparent"
                  BorderThickness="0"
                  ItemsSource="{Binding Roots}"
                  SelectedItemChanged="OnFolderSelected"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.ScrollUnit="Item"
                  VirtualizingPanel.VirtualizationMode="Recycling">
          <TreeView.ItemContainerStyle>
            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
              <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
              <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
              <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            </Style>
          </TreeView.ItemContainerStyle>
          <TreeView.ItemTemplate>
            <HierarchicalDataTemplate DataType="{x:Type index:FolderNodeViewModel}" ItemsSource="{Binding Children}">
              <StackPanel Orientation="Horizontal" ToolTip="{Binding Row.FullPath}">
                <controls:Glyph Margin="0,0,8,0" FontSize="14" Foreground="{DynamicResource Color.Folder}" Style="{StaticResource Typography.Icon}" Text="{Binding Row.Glyph}" />
                <TextBlock Style="{StaticResource Typography.Body}" Text="{Binding Name}" TextWrapping="NoWrap" />
                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource Typography.Caption}" Text="{Binding SizeText}" />
              </StackPanel>
            </HierarchicalDataTemplate>
          </TreeView.ItemTemplate>
        </TreeView>
      </Border>

      <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" AutomationProperties.Name="Resize folder pane" />

      <Border Grid.Column="2" Padding="0" Style="{StaticResource Card}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <ProgressBar Grid.Row="0" AutomationProperties.Name="Loading" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

          <!-- Treemap view: the list below stays the keyboard- and screen-reader-friendly table of the same items. -->
          <DockPanel Grid.Row="1" Visibility="{Binding IsTreemap, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Margin="12,8,12,6"
                       DockPanel.Dock="Top"
                       Style="{StaticResource Typography.Caption}"
                       Text="{Binding TreemapText}"
                       TextWrapping="Wrap" />
            <controls:TreemapControl x:Name="Treemap"
                                     Margin="8,0,8,8"
                                     AutomationProperties.HelpText="Arrow keys move between tiles, Enter opens a folder, Backspace goes up. Switch the treemap off for the list of the same items."
                                     AutomationProperties.Name="Treemap of the folder's contents"
                                     Foreground="{DynamicResource Color.TextPrimary}"
                                     ItemActivated="OnTileActivated"
                                     ItemsSource="{Binding TreemapItems}"
                                     PreviewKeyDown="OnTreemapKeyDown"
                                     SelectedItem="{Binding SelectedTile}"
                                     SelectionBrush="{DynamicResource Color.Accent}"
                                     Surface="{DynamicResource Color.Surface}" />
          </DockPanel>

          <DataGrid x:Name="FileGrid"
                    Grid.Row="1"
                    AutomationProperties.Name="Folder contents"
                    ItemsSource="{Binding Rows}"
                    MouseDoubleClick="OnRowDoubleClick"
                    PreviewKeyDown="OnGridKeyDown"
                    SelectedItem="{Binding SelectedRow}"
                    SelectionChanged="OnSelectionChanged"
                    Sorting="OnSorting"
                    Visibility="{Binding IsTreemap, Converter={StaticResource InverseBoolToVisibility}}"
                    AutoGenerateColumns="False"
                    BorderThickness="0"
                    CanUserReorderColumns="True"
                    CanUserResizeColumns="True"
                    EnableColumnVirtualization="True"
                    EnableRowVirtualization="True"
                    GridLinesVisibility="None"
                    HeadersVisibility="Column"
                    IsReadOnly="True"
                    SelectionMode="Extended"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.ScrollUnit="Item"
                    VirtualizingPanel.VirtualizationMode="Recycling">
            <DataGrid.ContextMenu>
              <ContextMenu>
                <MenuItem Command="{Binding RevealCommand}" Header="Open in File Explorer" />
                <MenuItem Command="{Binding CopyPathCommand}" Header="Copy path" />
                <Separator />
                <MenuItem Command="{Binding AddToReviewCommand}" Header="Add to review queue" />
              </ContextMenu>
            </DataGrid.ContextMenu>
            <!-- Only Name is star-sized; fixed columns set MinWidth equal to Width (TD-017). -->
            <DataGrid.Columns>
              <DataGridTemplateColumn Width="*" MinWidth="220" Header="Name" SortMemberPath="Name">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate DataType="{x:Type index:IndexRowViewModel}">
                    <StackPanel Orientation="Horizontal">
                      <controls:Glyph Margin="0,0,8,0" VerticalAlignment="Center" FontSize="14" Style="{StaticResource Icon.Entry}" Text="{Binding Glyph}" />
                      <TextBlock VerticalAlignment="Center" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Width="100" MinWidth="100" Binding="{Binding LogicalSize, Converter={StaticResource ByteSize}}" ElementStyle="{StaticResource Cell.Numeric}" Header="Size" SortMemberPath="LogicalSize" />
              <DataGridTextColumn Width="100" MinWidth="100" Binding="{Binding AllocatedSize, Converter={StaticResource ByteSize}}" ElementStyle="{StaticResource Cell.Numeric}" Header="On disk" SortMemberPath="AllocatedSize" />
              <DataGridTextColumn Width="130" MinWidth="130" Binding="{Binding TypeText}" ElementStyle="{StaticResource Cell.Secondary}" Header="Type" SortMemberPath="TypeText" />
              <DataGridTextColumn ElementStyle="{StaticResource Cell.Secondary}" Width="140" MinWidth="140" Binding="{Binding Modified, StringFormat=g}" Header="Modified" SortMemberPath="Modified" />
              <DataGridTextColumn ElementStyle="{StaticResource Cell.Secondary}" Width="80" MinWidth="80" Binding="{Binding AttributesText}" CanUserSort="False" Header="Attributes" />
              <DataGridTextColumn Width="150" MinWidth="150" Binding="{Binding CategoryText}" ElementStyle="{StaticResource Cell.Secondary}" Header="Category" SortMemberPath="CategoryText" />
              <DataGridTextColumn Width="180" MinWidth="180" Binding="{Binding StatusText}" CanUserSort="False" ElementStyle="{StaticResource Cell.Secondary}" Header="Notes" />
            </DataGrid.Columns>
          </DataGrid>

          <DockPanel Grid.Row="2" Margin="12,8">
            <DockPanel.Style>
              <Style TargetType="DockPanel">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                      <Condition Binding="{Binding HasMore}" Value="True" />
                      <Condition Binding="{Binding IsTreemap}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                  </MultiDataTrigger>
                </Style.Triggers>
              </Style>
            </DockPanel.Style>
            <Button Command="{Binding LoadMoreCommand}" Content="Show more" DockPanel.Dock="Left" />
            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource Typography.Caption}" Text="Items are loaded 500 at a time, in the current sort order." />
          </DockPanel>
        </Grid>
      </Border>

      <Border Grid.Column="3"
              Width="320"
              Margin="12,0,0,0"
              Style="{StaticResource Card}"
              Visibility="{Binding IsInspectorOpen, Converter={StaticResource BoolToVisibility}}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <views:EntryInspector DataContext="{Binding Details}" />
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- Error -->
    <Border Grid.Row="3"
            MaxWidth="640"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Style="{StaticResource Banner.Warning}"
            Visibility="{Binding State, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Error}">
      <StackPanel>
        <TextBlock Style="{StaticResource Typography.Title}" Text="Scan results couldn't be read" />
        <TextBlock Margin="0,4,0,8" Style="{StaticResource Typography.Body}" Text="{Binding ErrorMessage}" />
        <Button HorizontalAlignment="Left" Command="{Binding ReloadCommand}" Content="Try again" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
