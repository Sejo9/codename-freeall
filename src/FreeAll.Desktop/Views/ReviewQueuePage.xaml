<UserControl x:Class="FreeAll.Desktop.Views.ReviewQueuePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FreeAll.Desktop.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:index="clr-namespace:FreeAll.Desktop.ViewModels.Index"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=index:ReviewQueueViewModel}"
             x:ClassModifier="internal">
  <Grid Margin="{StaticResource Thickness.Page}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- What this list is, and what it is not -->
    <Border Grid.Row="0" MaxWidth="900" Margin="0,0,0,12" HorizontalAlignment="Left" Style="{StaticResource Banner.Info}">
      <DockPanel>
        <controls:Glyph Margin="0,2,10,0" VerticalAlignment="Top" DockPanel.Dock="Left" Foreground="{DynamicResource Color.Info}" Style="{StaticResource Typography.Icon}" Text="&#xE946;" />
        <TextBlock Style="{StaticResource Typography.Body}" TextWrapping="Wrap">
          Nothing here has been moved or deleted. Choose Clean up to review what would happen: every item is checked again first, you choose where it goes, and nothing changes until you confirm.
        </TextBlock>
      </DockPanel>
    </Border>

    <DockPanel Grid.Row="1" Margin="0,0,0,8">
      <Button Margin="8,0,0,0" Command="{Binding CleanUpCommand}" Content="Clean up…" DockPanel.Dock="Right" Style="{StaticResource Button.Accent}" ToolTip="Review the selected items, or all of them, before anything changes" />
      <Button Margin="8,0,0,0" Command="{Binding ClearCommand}" Content="Clear list" DockPanel.Dock="Right" ToolTip="Take every item off the list. Files are not changed." />
      <Button Margin="8,0,0,0" Command="{Binding ExportCommand}" Content="Export…" DockPanel.Dock="Right" />
      <Button Margin="8,0,0,0" Command="{Binding RemoveCommand}" Content="Remove from list" DockPanel.Dock="Right" ToolTip="Take the selected items off the list. Files are not changed." />
      <Button Margin="8,0,0,0" Command="{Binding CopyPathsCommand}" Content="Copy path" DockPanel.Dock="Right" />
      <Button Margin="8,0,0,0" Command="{Binding RevealCommand}" Content="Open in File Explorer" DockPanel.Dock="Right" />
      <TextBlock VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" Style="{StaticResource Typography.Caption}" TextWrapping="Wrap">
        <Run Text="{Binding TotalText, Mode=OneWay}" />
        <Run Text="{Binding StatusMessage, Mode=OneWay}" />
      </TextBlock>
    </DockPanel>

    <Border Grid.Row="2"
            MaxWidth="560"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Style="{StaticResource Card}"
            Visibility="{Binding Items.Count, Converter={StaticResource InverseNullToVisibility}}">
      <StackPanel>
        <TextBlock Style="{StaticResource Typography.Title}" Text="The review queue is empty" />
        <TextBlock Margin="0,4,0,0" Style="{StaticResource Typography.Body}" Text="Select files or folders in Storage Explorer, Large Files or Search, then choose Add to review queue." TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Border Grid.Row="2" Padding="0" Style="{StaticResource Card}" Visibility="{Binding Items.Count, Converter={StaticResource NullToVisibility}}">
      <DataGrid AutomationProperties.Name="Items to review"
                CanUserSortColumns="False"
                ItemsSource="{Binding Items}"
                SelectionChanged="OnSelectionChanged"
                AutoGenerateColumns="False"
                BorderThickness="0"
                CanUserReorderColumns="True"
                CanUserResizeColumns="True"
                EnableColumnVirtualization="True"
                EnableRowVirtualization="True"
                GridLinesVisibility="None"
                HeadersVisibility="Column"
                IsReadOnly="True"
                SelectionMode="Extended"
                VirtualizingPanel.IsVirtualizing="True"
                VirtualizingPanel.ScrollUnit="Item"
                VirtualizingPanel.VirtualizationMode="Recycling">
        <DataGrid.Columns>
          <DataGridTemplateColumn Width="*" MinWidth="240" Header="Item">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate DataType="{x:Type index:ReviewRowViewModel}">
                <StackPanel Orientation="Horizontal" ToolTip="{Binding DisplayPath}">
                  <controls:Glyph Margin="0,0,8,0" VerticalAlignment="Center" FontSize="14" Style="{StaticResource Icon.Entry}" Text="{Binding Glyph}" />
                  <TextBlock VerticalAlignment="Center" Text="{Binding DisplayPath}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Width="100" MinWidth="100" Binding="{Binding LogicalSize, Converter={StaticResource ByteSize}}" ElementStyle="{StaticResource Cell.Numeric}" Header="Size" />
          <DataGridTextColumn Width="100" MinWidth="100" Binding="{Binding AllocatedSize, Converter={StaticResource ByteSize}}" ElementStyle="{StaticResource Cell.Numeric}" Header="On disk" />
          <DataGridTextColumn Width="170" MinWidth="170" Binding="{Binding TypeText}" ElementStyle="{StaticResource Cell.Secondary}" Header="Type" />
          <DataGridTextColumn Width="130" MinWidth="130" Binding="{Binding OriginText}" ElementStyle="{StaticResource Cell.Secondary}" Header="Added from" />
          <DataGridTextColumn Width="140" MinWidth="140" Binding="{Binding Added, StringFormat=g}" ElementStyle="{StaticResource Cell.Secondary}" Header="Added" />
          <DataGridTextColumn Width="190" MinWidth="190" Binding="{Binding NoteText}" ElementStyle="{StaticResource Cell.Secondary}" Header="Notes" />
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <Border Grid.Row="2"
            MaxWidth="640"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Style="{StaticResource Banner.Warning}"
            Visibility="{Binding State, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Error}">
      <StackPanel>
        <TextBlock Style="{StaticResource Typography.Title}" Text="The review queue couldn't be read" />
        <TextBlock Margin="0,4,0,0" Style="{StaticResource Typography.Body}" Text="{Binding ErrorMessage}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
