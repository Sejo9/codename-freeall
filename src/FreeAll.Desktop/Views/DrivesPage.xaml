<UserControl x:Class="FreeAll.Desktop.Views.DrivesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:FreeAll.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DrivesViewModel}"
             x:ClassModifier="internal">
  <Grid Margin="{StaticResource Thickness.Page}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Toolbar and scan scope -->
    <StackPanel Grid.Row="0" Margin="0,0,0,16">
      <StackPanel Orientation="Horizontal">
        <Button Command="{Binding ScanDefaultDrivesCommand}" Style="{StaticResource Button.Accent}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Margin="0,0,8,0" FontSize="14" Foreground="{DynamicResource Color.OnAccent}" Style="{StaticResource Typography.Icon}" Text="&#xE721;" />
            <TextBlock Text="Scan default drives" />
          </StackPanel>
        </Button>
        <Button Margin="8,0,0,0"
                Command="{Binding UpdateDefaultDrivesCommand}"
                ToolTip="Re-reads only the folders that changed since the last scan of each drive, using the drive's change journal. Runs a full scan when that isn't possible, and says why.">
          <StackPanel Orientation="Horizontal">
            <TextBlock Margin="0,0,8,0" FontSize="14" Style="{StaticResource Typography.Icon}" Text="&#xE895;" />
            <TextBlock Text="Update default drives" />
          </StackPanel>
        </Button>
        <Button Margin="8,0,0,0" Command="{Binding RefreshCommand}" AutomationProperties.Name="Refresh drive list">
          <StackPanel Orientation="Horizontal">
            <TextBlock Margin="0,0,8,0" FontSize="14" Style="{StaticResource Typography.Icon}" Text="&#xE72C;" />
            <TextBlock Text="Refresh" />
          </StackPanel>
        </Button>
        <TextBlock Margin="16,0,0,0"
                   VerticalAlignment="Center"
                   Style="{StaticResource Typography.Caption}"
                   Text="{Binding LastRefreshed, StringFormat='Checked at {0:t}'}"
                   Visibility="{Binding LastRefreshed, Converter={StaticResource NullToVisibility}}" />
      </StackPanel>
      <TextBlock MaxWidth="900"
                 Margin="0,8,0,0"
                 HorizontalAlignment="Left"
                 Style="{StaticResource Typography.Caption}"
                 Text="{Binding ScopeText}"
                 TextWrapping="Wrap"
                 Visibility="{Binding ScopeText, Converter={StaticResource NullToVisibility}}" />

      <!-- Running scan -->
      <Border MaxWidth="900"
              Margin="0,12,0,0"
              HorizontalAlignment="Left"
              Style="{StaticResource Card}"
              Visibility="{Binding Activity.IsRunning, Converter={StaticResource BoolToVisibility}}">
        <DockPanel>
          <StackPanel Margin="16,0,0,0" VerticalAlignment="Center" DockPanel.Dock="Right">
            <Button HorizontalAlignment="Right" Command="{Binding Activity.CancelCommand}" Content="Cancel scan" />
            <TextBlock MaxWidth="220"
                       Margin="0,6,0,0"
                       Style="{StaticResource Typography.Caption}"
                       Text="Stops after the folder being read. Results so far are kept as a partial scan."
                       TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel>
            <TextBlock AutomationProperties.LiveSetting="Polite" Style="{StaticResource Typography.Title}" Text="{Binding Activity.Title}" />
            <TextBlock Margin="0,2,0,0" Style="{StaticResource Typography.Body}" Text="{Binding Activity.Detail}" Typography.NumeralAlignment="Tabular" />
            <ProgressBar Margin="0,10,0,8" AutomationProperties.Name="Scan in progress" IsIndeterminate="True" />
            <TextBlock FontFamily="{StaticResource Font.Monospace}"
                       FontSize="12"
                       Foreground="{DynamicResource Color.TextSecondary}"
                       Text="{Binding Activity.CurrentPath}"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Last result -->
      <Border MaxWidth="900"
              Margin="0,12,0,0"
              HorizontalAlignment="Left"
              Visibility="{Binding Activity.LastResult, Converter={StaticResource NullToVisibility}}">
        <Border.Style>
          <Style TargetType="Border" BasedOn="{StaticResource Banner.Info}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding Activity.LastResultNeedsAttention}" Value="True">
                <Setter Property="Background" Value="{DynamicResource Color.WarningBackground}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <TextBlock Style="{StaticResource Typography.Body}" Text="{Binding Activity.LastResult}" />
      </Border>
    </StackPanel>

    <!-- Loading -->
    <StackPanel Grid.Row="1"
                MaxWidth="360"
                HorizontalAlignment="Left"
                Visibility="{Binding State, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Loading}">
      <TextBlock Style="{StaticResource Typography.Body}" Text="Looking for drives…" />
      <ProgressBar Margin="0,8,0,0" AutomationProperties.Name="Looking for drives" IsIndeterminate="True" />
    </StackPanel>

    <!-- Error -->
    <Border Grid.Row="1"
            MaxWidth="640"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Style="{StaticResource Banner.Warning}"
            Visibility="{Binding State, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Error}">
      <DockPanel>
        <TextBlock Margin="0,2,12,0"
                   VerticalAlignment="Top"
                   DockPanel.Dock="Left"
                   Foreground="{DynamicResource Color.Warning}"
                   Style="{StaticResource Typography.Icon}"
                   Text="&#xE7BA;" />
        <StackPanel>
          <TextBlock Style="{StaticResource Typography.Title}" Text="Drives couldn't be listed" />
          <TextBlock Margin="0,4,0,0" Style="{StaticResource Typography.Body}" Text="{Binding ErrorMessage}" />
          <Button Margin="0,12,0,0"
                  HorizontalAlignment="Left"
                  Command="{Binding RefreshCommand}"
                  Content="Try again" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Results -->
    <ScrollViewer Grid.Row="1"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  Visibility="{Binding State, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Ready}">
      <StackPanel>
        <ItemsControl AutomationProperties.Name="Drives" Focusable="False" ItemsSource="{Binding Drives}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:DriveItemViewModel}">
              <Border Width="332"
                      Margin="0,0,16,16"
                      AutomationProperties.Name="{Binding AutomationName}"
                      Focusable="True"
                      Style="{StaticResource Card}">
                <StackPanel>
                  <DockPanel>
                    <TextBlock Margin="0,0,12,0"
                               DockPanel.Dock="Left"
                               FontSize="28"
                               Style="{StaticResource Typography.Icon}"
                               Text="{Binding Glyph}" />
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Style="{StaticResource Typography.Title}" Text="{Binding Title}" />
                      <TextBlock Style="{StaticResource Typography.Caption}" Text="{Binding Subtitle}" />
                    </StackPanel>
                  </DockPanel>

                  <ProgressBar Margin="0,16,0,8"
                               AutomationProperties.Name="{Binding UsedText}"
                               Style="{StaticResource UsageMeter}"
                               Value="{Binding UsedFraction, Mode=OneTime}"
                               Visibility="{Binding HasCapacity, Converter={StaticResource BoolToVisibility}}" />
                  <DockPanel Margin="0,0,0,12">
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Typography.Caption}" Text="{Binding UsedText}" Typography.NumeralAlignment="Tabular" />
                    <TextBlock Style="{StaticResource Typography.Numeric}" Text="{Binding FreeText}" />
                  </DockPanel>

                  <StackPanel Orientation="Horizontal">
                    <TextBlock Margin="0,0,6,0" FontSize="12" Text="{Binding ScanSelectionGlyph}">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Typography.Icon}">
                          <Setter Property="Foreground" Value="{DynamicResource Color.TextSecondary}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsIncludedByDefault}" Value="True">
                              <Setter Property="Foreground" Value="{DynamicResource Color.Success}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Style="{StaticResource Typography.Caption}" Text="{Binding ScanSelectionText}" />
                  </StackPanel>

                  <DockPanel Margin="0,8,0,0">
                    <Button Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{Binding ShortName, StringFormat='Scan {0}'}"
                            Command="{Binding DataContext.ScanDriveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"
                            Content="Scan"
                            DockPanel.Dock="Right"
                            Visibility="{Binding CanScan, Converter={StaticResource BoolToVisibility}}" />
                    <Button Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{Binding ShortName, StringFormat='Update {0} from its change journal'}"
                            Command="{Binding DataContext.UpdateDriveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"
                            Content="Update"
                            DockPanel.Dock="Right"
                            ToolTip="Re-read only what changed since the last scan"
                            Visibility="{Binding CanUpdate, Converter={StaticResource BoolToVisibility}}" />
                    <DockPanel VerticalAlignment="Center">
                      <TextBlock Margin="0,1,6,0" VerticalAlignment="Top" DockPanel.Dock="Left" FontSize="12">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock" BasedOn="{StaticResource Typography.Icon}">
                            <Setter Property="Text" Value="&#xE81C;" />
                            <Setter Property="Foreground" Value="{DynamicResource Color.TextSecondary}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding LastScanNeedsAttention}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Color.Warning}" />
                                <Setter Property="Text" Value="&#xE7BA;" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                      <TextBlock Style="{StaticResource Typography.Caption}" Text="{Binding LastScanText}" TextWrapping="Wrap" />
                    </DockPanel>
                  </DockPanel>

                  <Expander Margin="0,12,0,0" Header="Details">
                    <StackPanel Margin="0,4,0,0">
                      <TextBlock Style="{StaticResource FieldLabel}" Text="Mount points" />
                      <TextBox AutomationProperties.Name="Mount points" Style="{StaticResource SelectableMonospace}" Text="{Binding MountPointsText, Mode=OneTime}" />
                      <TextBlock Style="{StaticResource FieldLabel}" Text="File system" />
                      <TextBlock Style="{StaticResource Typography.Body}" Text="{Binding FileSystemText}" />
                      <TextBlock Style="{StaticResource FieldLabel}" Text="Volume ID" />
                      <TextBox AutomationProperties.Name="Volume ID" Style="{StaticResource SelectableMonospace}" Text="{Binding VolumeIdText, Mode=OneTime}" />
                    </StackPanel>
                  </Expander>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Margin="0,8,0,0" Visibility="{Binding NetworkDrives.Count, Converter={StaticResource NullToVisibility}, FallbackValue=Collapsed}">
          <TextBlock Style="{StaticResource SectionHeader}" Text="Network drives" />
          <TextBlock Style="{StaticResource Typography.Caption}" Text="Network drives are not scanned by default." />
          <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding NetworkDrives}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Style="{StaticResource Typography.Body}" Text="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel MaxWidth="900" Margin="0,16,0,0" HorizontalAlignment="Left">
          <TextBlock AutomationProperties.HeadingLevel="Level2" Style="{StaticResource SectionHeader}" Text="Excluded folders" />
          <TextBlock Style="{StaticResource Typography.Caption}" Text="Every scan skips these folders and everything inside them. They are not opened or read." TextWrapping="Wrap" />
          <ItemsControl Margin="0,8,0,0" AutomationProperties.Name="Excluded folders" Focusable="False" ItemsSource="{Binding Exclusions}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:ExclusionItemViewModel}">
                <Border Margin="0,0,0,6" Padding="12,8" Style="{StaticResource Card}">
                  <DockPanel>
                    <Button Margin="12,0,0,0"
                            AutomationProperties.Name="{Binding DisplayPath, StringFormat='Stop excluding {0}'}"
                            Command="{Binding DataContext.RemoveExclusionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"
                            Content="Remove"
                            DockPanel.Dock="Right" />
                    <TextBlock Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               DockPanel.Dock="Right"
                               Style="{StaticResource Typography.Caption}"
                               Text="{Binding StatusText}" />
                    <TextBox VerticalAlignment="Center" AutomationProperties.Name="Excluded folder" Style="{StaticResource SelectableMonospace}" Text="{Binding DisplayPath, Mode=OneTime}" />
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Margin="0,4,0,0"
                     Style="{StaticResource Typography.Caption}"
                     Text="No folders are excluded."
                     Visibility="{Binding Exclusions.Count, Converter={StaticResource InverseNullToVisibility}}" />
          <Button Margin="0,8,0,0" HorizontalAlignment="Left" Command="{Binding AddExclusionCommand}" Content="Add folder…" />
        </StackPanel>

        <StackPanel Margin="0,16,0,0" Visibility="{Binding Problems.Count, Converter={StaticResource NullToVisibility}, FallbackValue=Collapsed}">
          <TextBlock Style="{StaticResource SectionHeader}" Text="Some details couldn't be read" />
          <ItemsControl ItemsSource="{Binding Problems}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Style="{StaticResource Typography.Body}" Text="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <TextBlock MaxWidth="720"
                   Margin="0,16,0,0"
                   HorizontalAlignment="Left"
                   Style="{StaticResource Typography.Caption}"
                   Text="Used and free space are reported by Windows for the whole volume. They can differ from the total size of scanned files because of system metadata, reserved storage, snapshots and locations that can't be read." />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
