<UserControl x:Class="FreeAll.Desktop.Views.EntryInspector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:index="clr-namespace:FreeAll.Desktop.ViewModels.Index"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=index:EntryDetailsViewModel}"
             x:ClassModifier="internal">
  <!-- Details of the selected folder or file. DataContext is an EntryDetailsViewModel, or null. -->
  <Grid>
    <TextBlock Style="{StaticResource Typography.Caption}"
               Text="Select a folder or file to see its details."
               TextWrapping="Wrap"
               Visibility="{Binding Converter={StaticResource InverseNullToVisibility}}" />
    <StackPanel Visibility="{Binding Converter={StaticResource NullToVisibility}}">
      <DockPanel>
        <TextBlock Margin="0,2,10,0"
                   VerticalAlignment="Top"
                   DockPanel.Dock="Left"
                   FontSize="20"
                   Foreground="{DynamicResource Color.TextSecondary}"
                   Style="{StaticResource Typography.Icon}"
                   Text="{Binding Glyph}" />
        <StackPanel>
          <TextBlock AutomationProperties.HeadingLevel="Level3" Style="{StaticResource Typography.Title}" Text="{Binding Name}" TextTrimming="None" TextWrapping="Wrap" />
          <TextBlock Style="{StaticResource Typography.Caption}" Text="{Binding Kind}" />
        </StackPanel>
      </DockPanel>
      <ItemsControl Focusable="False" ItemsSource="{Binding Fields}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type index:DetailField}">
            <StackPanel>
              <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Label}" />
              <TextBox AutomationProperties.Name="{Binding Label}"
                       Style="{StaticResource SelectableMonospace}"
                       Text="{Binding Value, Mode=OneWay}"
                       Visibility="{Binding IsPath, Converter={StaticResource BoolToVisibility}}" />
              <TextBlock Style="{StaticResource Typography.Body}" Text="{Binding Value}" Visibility="{Binding IsPath, Converter={StaticResource InverseBoolToVisibility}}" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </Grid>
</UserControl>
