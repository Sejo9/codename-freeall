<UserControl x:Class="FreeAll.Desktop.Views.ResiduePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FreeAll.Desktop.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:residue="clr-namespace:FreeAll.Desktop.ViewModels.Residue"
             xmlns:core="clr-namespace:FreeAll.Core.Residue;assembly=FreeAll.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=residue:ResidueViewModel}"
             x:ClassModifier="internal">
  <Grid Margin="{StaticResource Thickness.Page}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Toolbar -->
    <DockPanel Grid.Row="0" Margin="0,0,0,12">
      <Button Margin="8,0,0,0" Command="{Binding ExportCommand}" Content="Export…" DockPanel.Dock="Right" />
      <ToggleButton Margin="8,0,0,0" Content="Installed applications" DockPanel.Dock="Right" IsChecked="{Binding ShowApplications}" ToolTip="The applications FreeAll found, and those it saw installed before" />
      <WrapPanel>
        <Button AutomationProperties.Name="Look again" Margin="0,0,8,0" Command="{Binding AnalyseCommand}" Style="{StaticResource Button.Accent}">
          <StackPanel Orientation="Horizontal">
            <controls:Glyph Margin="0,0,8,0" FontSize="14" Foreground="{DynamicResource Color.OnAccent}" Style="{StaticResource Typography.Icon}" Text="&#xE72C;" />
            <TextBlock Text="Look again" />
          </StackPanel>
        </Button>
        <ComboBox MinWidth="220" Margin="0,0,8,0" AutomationProperties.Name="Confidence" DisplayMemberPath="Label" ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}" />
        <CheckBox VerticalAlignment="Center" Content="Show folders you have decided on" IsChecked="{Binding ShowDecided}" />
      </WrapPanel>
    </DockPanel>

    <!-- What this page is, and is not -->
    <StackPanel Grid.Row="1" Margin="0,0,0,12">
      <Border MaxWidth="1100" HorizontalAlignment="Left" Style="{StaticResource Banner.Warning}">
        <DockPanel>
          <controls:Glyph Margin="0,2,10,0" VerticalAlignment="Top" DockPanel.Dock="Left" Foreground="{DynamicResource Color.Warning}" Style="{StaticResource Typography.Icon}" Text="&#xE7BA;" />
          <TextBlock Style="{StaticResource Typography.Body}" TextWrapping="Wrap">
            <Run FontWeight="SemiBold" Text="A leftover folder can still hold settings, documents or licences." />
            <Run Text="Confidence says how strongly the evidence points to a removed program; it never means a folder is safe to remove. Nothing is removed here: keep, ignore, or add folders to the review queue to decide later." />
          </TextBlock>
        </DockPanel>
      </Border>
      <TextBlock Margin="0,8,0,0" Style="{StaticResource Typography.Caption}" Text="{Binding SummaryText}" TextWrapping="Wrap" />
      <TextBlock Style="{StaticResource Typography.Caption}" Text="{Binding NotesText}" TextWrapping="Wrap" Visibility="{Binding NotesText, Converter={StaticResource NullToVisibility}}" />
      <TextBlock AutomationProperties.LiveSetting="Polite" Style="{StaticResource Typography.Caption}" Text="{Binding StatusMessage}" Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibility}}" />
    </StackPanel>

    <!-- No scan -->
    <Border Grid.Row="2"
            MaxWidth="560"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Style="{StaticResource Card}"
            Visibility="{Binding HasScan, Converter={StaticResource InverseBoolToVisibility}}">
      <StackPanel>
        <TextBlock Style="{StaticResource Typography.Title}" Text="Scan the Windows drive first" />
        <TextBlock Margin="0,4,0,0" Style="{StaticResource Typography.Body}" Text="Leftovers are found in the scan of the drive Windows is on (usually C:). Scan it from the Drives page, then come back." TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <!-- Leftovers -->
    <Grid Grid.Row="2">
      <Grid.Style>
        <Style TargetType="Grid">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Binding="{Binding HasScan}" Value="True" />
                <Condition Binding="{Binding ShowApplications}" Value="False" />
              </MultiDataTrigger.Conditions>
              <Setter Property="Visibility" Value="Visible" />
            </MultiDataTrigger>
          </Style.Triggers>
        </Style>
      </Grid.Style>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <Border Padding="0" Style="{StaticResource Card}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <ProgressBar AutomationProperties.Name="Looking for leftovers" IsIndeterminate="True" Visibility="{Binding State, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Loading}" />
          <TextBlock Grid.Row="1"
                     Margin="16"
                     Style="{StaticResource Typography.Body}"
                     Text="No possible leftovers match these filters."
                     Visibility="{Binding Rows.Count, Converter={StaticResource InverseNullToVisibility}}" />
          <DataGrid Grid.Row="1"
                    AutomationProperties.Name="Possible leftovers"
                    CanUserSortColumns="False"
                    ItemsSource="{Binding Rows}"
                    SelectedItem="{Binding SelectedRow}"
                    SelectionChanged="OnSelectionChanged"
                    Visibility="{Binding Rows.Count, Converter={StaticResource NullToVisibility}}"
                    AutoGenerateColumns="False"
                    BorderThickness="0"
                    CanUserReorderColumns="True"
                    CanUserResizeColumns="True"
                    EnableColumnVirtualization="True"
                    EnableRowVirtualization="True"
                    GridLinesVisibility="None"
                    HeadersVisibility="Column"
                    IsReadOnly="True"
                    SelectionMode="Extended"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.ScrollUnit="Item"
                    VirtualizingPanel.VirtualizationMode="Recycling">
            <DataGrid.ContextMenu>
              <ContextMenu>
                <MenuItem Command="{Binding KeepCommand}" Header="Keep" />
                <MenuItem Command="{Binding IgnoreCommand}" Header="Ignore" />
                <MenuItem Command="{Binding AddToReviewCommand}" Header="Add to review queue" />
                <Separator />
                <MenuItem Command="{Binding RevealCommand}" Header="Open in File Explorer" />
                <MenuItem Command="{Binding ShowInExplorerCommand}" Header="Show in Storage Explorer" />
                <MenuItem Command="{Binding CopyPathCommand}" Header="Copy path" />
              </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
              <DataGridTemplateColumn Width="*" MinWidth="180" Header="Folder">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate DataType="{x:Type residue:ResidueRowViewModel}">
                    <StackPanel VerticalAlignment="Center" ToolTip="{Binding FullPath}">
                      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                      <TextBlock FontSize="11" Foreground="{DynamicResource Color.TextSecondary}" Text="{Binding FullPath}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Width="96" MinWidth="96" Binding="{Binding AllocatedSize, Converter={StaticResource ByteSize}}" ElementStyle="{StaticResource Cell.Numeric}" Header="On disk" />
              <DataGridTextColumn Width="92" MinWidth="92" Binding="{Binding ConfidenceText}" ElementStyle="{StaticResource Cell.Secondary}" Header="Confidence" />
              <DataGridTemplateColumn Width="88" MinWidth="88" Header="Risk">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate DataType="{x:Type residue:ResidueRowViewModel}">
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                      <controls:Glyph Margin="0,0,6,0" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Color.Warning}" Style="{StaticResource Typography.Icon}" Text="&#xE7BA;" Visibility="{Binding NeedsAttention, Converter={StaticResource BoolToVisibility}}" />
                      <TextBlock VerticalAlignment="Center" Text="{Binding RiskText}" />
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Width="0.6*" MinWidth="120" Binding="{Binding GroupName}" ElementStyle="{StaticResource Cell.Secondary}" Header="Belongs to" />
              <DataGridTextColumn Width="96" MinWidth="96" Binding="{Binding LastChange, StringFormat=d}" ElementStyle="{StaticResource Cell.Secondary}" Header="Last change" />
              <DataGridTextColumn Width="110" MinWidth="110" Binding="{Binding DecisionText}" ElementStyle="{StaticResource Cell.Secondary}" Header="Decision" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>

      <!-- Evidence and decisions for the selected folder -->
      <Border Grid.Column="1" Width="320" Margin="12,0,0,0" Style="{StaticResource Card}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <Grid>
            <TextBlock Style="{StaticResource Typography.Caption}" Text="Select a folder to see why it's listed." TextWrapping="Wrap" Visibility="{Binding SelectedRow, Converter={StaticResource InverseNullToVisibility}}" />
            <StackPanel Visibility="{Binding SelectedRow, Converter={StaticResource NullToVisibility}}">
              <TextBlock AutomationProperties.HeadingLevel="Level3" Style="{StaticResource Typography.Title}" Text="{Binding SelectedRow.Name}" TextWrapping="Wrap" />
              <TextBox Margin="0,4,0,0" AutomationProperties.Name="Full path" Style="{StaticResource SelectableMonospace}" Text="{Binding SelectedRow.FullPath, Mode=OneWay}" />

              <TextBlock Style="{StaticResource FieldLabel}" Text="Confidence" />
              <TextBlock Style="{StaticResource Typography.Body}" TextWrapping="Wrap">
                <Run FontWeight="SemiBold" Text="{Binding SelectedRow.ConfidenceText, Mode=OneWay}" />
                <Run Text="·" />
                <Run Text="{Binding SelectedRow.ConfidenceMeaning, Mode=OneWay}" />
              </TextBlock>
              <TextBlock Style="{StaticResource FieldLabel}" Text="Risk of removing it" />
              <TextBlock Style="{StaticResource Typography.Body}" TextWrapping="Wrap">
                <Run FontWeight="SemiBold" Text="{Binding SelectedRow.RiskText, Mode=OneWay}" />
                <Run Text="·" />
                <Run Text="{Binding SelectedRow.RiskMeaning, Mode=OneWay}" />
              </TextBlock>

              <TextBlock Style="{StaticResource FieldLabel}" Text="Evidence" />
              <ItemsControl Focusable="False" ItemsSource="{Binding SelectedRow.Evidence}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type core:ResidueEvidence}">
                    <DockPanel Margin="0,0,0,6">
                      <TextBlock Margin="0,3,8,0" VerticalAlignment="Top" DockPanel.Dock="Left" FontSize="12">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock" BasedOn="{StaticResource Typography.Icon}">
                            <Setter Property="Text" Value="&#xE73E;" />
                            <Setter Property="Foreground" Value="{DynamicResource Color.TextSecondary}" />
                            <Setter Property="ToolTip" Value="Points to a leftover" />
                            <Setter Property="AutomationProperties.Name" Value="Points to a leftover" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding Supports}" Value="False">
                                <Setter Property="Text" Value="&#xE946;" />
                                <Setter Property="ToolTip" Value="Points the other way, or raises the risk" />
                                <Setter Property="AutomationProperties.Name" Value="Points the other way, or raises the risk" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                      <TextBlock Style="{StaticResource Typography.Body}" Text="{Binding Text}" TextWrapping="Wrap" />
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Style="{StaticResource FieldLabel}" Text="This folder" />
              <WrapPanel>
                <Button Margin="0,4,8,0" Command="{Binding KeepCommand}" Content="Keep" ToolTip="Don't suggest it again" />
                <Button Margin="0,4,8,0" Command="{Binding IgnoreCommand}" Content="Ignore" ToolTip="Hide it from the list" />
                <Button Margin="0,4,8,0" Command="{Binding AddToReviewCommand}" Content="Add to review queue" />
                <Button Margin="0,4,8,0" Command="{Binding UndoCommand}" Content="Undo decision" />
              </WrapPanel>
              <DockPanel Margin="0,8,0,0">
                <Button Margin="8,0,0,0" Command="{Binding MarkInUseCommand}" Content="In use" DockPanel.Dock="Right" />
                <ComboBox AutomationProperties.Name="Program that uses this folder" IsEditable="True" ItemsSource="{Binding OwnerChoices}" Text="{Binding SelectedOwner, UpdateSourceTrigger=PropertyChanged}" ToolTip="Name the program that still uses this folder" />
              </DockPanel>

              <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding SelectedRow.GroupName, StringFormat='Everything attributed to {0}'}" />
              <WrapPanel>
                <Button Margin="0,4,8,0" Command="{Binding KeepGroupCommand}" Content="Keep all" />
                <Button Margin="0,4,8,0" Command="{Binding IgnoreGroupCommand}" Content="Ignore all" />
              </WrapPanel>

              <TextBlock Style="{StaticResource FieldLabel}" Text="Look at it" />
              <WrapPanel>
                <Button Margin="0,4,8,0" Command="{Binding RevealCommand}" Content="Open in File Explorer" />
                <Button Margin="0,4,8,0" Command="{Binding ShowInExplorerCommand}" Content="Show in Storage Explorer" />
                <Button Margin="0,4,8,0" Command="{Binding CopyPathCommand}" Content="Copy path" />
              </WrapPanel>
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- Installed and former applications -->
    <Border Grid.Row="2" Padding="0" Style="{StaticResource Card}" Visibility="{Binding ShowApplications, Converter={StaticResource BoolToVisibility}}">
      <DataGrid AutomationProperties.Name="Applications"
                CanUserSortColumns="True"
                ItemsSource="{Binding Applications}"
                AutoGenerateColumns="False"
                BorderThickness="0"
                CanUserReorderColumns="True"
                CanUserResizeColumns="True"
                EnableRowVirtualization="True"
                GridLinesVisibility="None"
                HeadersVisibility="Column"
                IsReadOnly="True"
                SelectionMode="Single"
                VirtualizingPanel.IsVirtualizing="True"
                VirtualizingPanel.VirtualizationMode="Recycling">
        <DataGrid.Columns>
          <DataGridTextColumn Width="*" MinWidth="220" Binding="{Binding Name}" ElementStyle="{StaticResource Cell.Secondary}" Header="Application" />
          <DataGridTextColumn Width="180" MinWidth="180" Binding="{Binding Publisher}" ElementStyle="{StaticResource Cell.Secondary}" Header="Publisher" />
          <DataGridTextColumn Width="110" MinWidth="110" Binding="{Binding Version}" ElementStyle="{StaticResource Cell.Secondary}" Header="Version" />
          <DataGridTextColumn Width="190" MinWidth="190" Binding="{Binding SourceText}" ElementStyle="{StaticResource Cell.Secondary}" Header="Kind" />
          <DataGridTextColumn Width="160" MinWidth="160" Binding="{Binding StatusText}" ElementStyle="{StaticResource Cell.Secondary}" Header="Status" />
          <DataGridTextColumn Width="280" MinWidth="200" Binding="{Binding Location}" ElementStyle="{StaticResource Cell.Secondary}" Header="Install folder" />
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <Border Grid.Row="2"
            MaxWidth="640"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Style="{StaticResource Banner.Warning}"
            Visibility="{Binding State, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Error}">
      <StackPanel>
        <TextBlock Style="{StaticResource Typography.Title}" Text="Leftovers couldn't be looked for" />
        <TextBlock Margin="0,4,0,8" Style="{StaticResource Typography.Body}" Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
        <Button HorizontalAlignment="Left" Command="{Binding AnalyseCommand}" Content="Try again" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
