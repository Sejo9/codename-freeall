<UserControl x:Class="FreeAll.Desktop.Views.ActivityPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:cleanup="clr-namespace:FreeAll.Desktop.ViewModels.Cleanup"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=cleanup:ActivityViewModel}"
             x:ClassModifier="internal">
  <Grid Margin="{StaticResource Thickness.Page}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <DockPanel Margin="0,0,0,12">
      <ToggleButton Content="Quarantine" DockPanel.Dock="Left" IsChecked="{Binding ShowQuarantine}" ToolTip="What FreeAll holds, with restore" />
      <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" Style="{StaticResource Typography.Caption}" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
    </DockPanel>

    <!-- Operations -->
    <Grid Grid.Row="1" Visibility="{Binding ShowQuarantine, Converter={StaticResource InverseBoolToVisibility}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" MinHeight="140" />
        <RowDefinition Height="1.2*" MinHeight="180" />
      </Grid.RowDefinitions>
      <Border Padding="0" Style="{StaticResource Card}">
        <Grid>
          <TextBlock Margin="16" Style="{StaticResource Typography.Body}" Text="Nothing has been cleaned up yet." Visibility="{Binding Operations.Count, Converter={StaticResource InverseNullToVisibility}}" />
          <DataGrid AutomationProperties.Name="Operations"
                    ItemsSource="{Binding Operations}"
                    SelectedItem="{Binding SelectedOperation}"
                    Visibility="{Binding Operations.Count, Converter={StaticResource NullToVisibility}}"
                    AutoGenerateColumns="False"
                    BorderThickness="0"
                    CanUserResizeColumns="True"
                    CanUserSortColumns="False"
                    EnableRowVirtualization="True"
                    GridLinesVisibility="None"
                    HeadersVisibility="Column"
                    IsReadOnly="True"
                    SelectionMode="Single"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.VirtualizationMode="Recycling">
            <DataGrid.Columns>
              <DataGridTextColumn Width="150" MinWidth="150" Binding="{Binding Started, StringFormat=g}" ElementStyle="{StaticResource Cell.Secondary}" Header="When" />
              <DataGridTextColumn Width="*" MinWidth="220" Binding="{Binding KindText}" ElementStyle="{StaticResource Cell.Secondary}" Header="What" />
              <DataGridTemplateColumn Width="190" MinWidth="170" Header="Outcome">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate DataType="{x:Type cleanup:OperationRowViewModel}">
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                      <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" AutomationProperties.Name="Needs attention" FontSize="12" Foreground="{DynamicResource Color.Warning}" Style="{StaticResource Typography.Icon}" Text="&#xE7BA;" Visibility="{Binding NeedsAttention, Converter={StaticResource BoolToVisibility}}" />
                      <TextBlock VerticalAlignment="Center" Text="{Binding StateText}" />
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Width="120" MinWidth="120" Binding="{Binding ResultText}" ElementStyle="{StaticResource Cell.Secondary}" Header="Items" />
              <DataGridTextColumn Width="130" MinWidth="130" Binding="{Binding SpaceText}" ElementStyle="{StaticResource Cell.Secondary}" Header="Space" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>
      <Border Grid.Row="1" Margin="0,12,0,0" Padding="0" Style="{StaticResource Card}">
        <Grid>
          <TextBlock Margin="16" Style="{StaticResource Typography.Caption}" Text="Select an operation to see what happened to each item." Visibility="{Binding Items.Count, Converter={StaticResource InverseNullToVisibility}}" />
          <DataGrid AutomationProperties.Name="Items in this operation"
                    ItemsSource="{Binding Items}"
                    Visibility="{Binding Items.Count, Converter={StaticResource NullToVisibility}}"
                    AutoGenerateColumns="False"
                    BorderThickness="0"
                    CanUserResizeColumns="True"
                    CanUserSortColumns="False"
                    EnableRowVirtualization="True"
                    GridLinesVisibility="None"
                    HeadersVisibility="Column"
                    IsReadOnly="True"
                    SelectionMode="Single"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.VirtualizationMode="Recycling">
            <DataGrid.Columns>
              <DataGridTextColumn Width="170" MinWidth="150" Binding="{Binding StateText}" ElementStyle="{StaticResource Cell.Secondary}" Header="Result" />
              <DataGridTextColumn Width="*" MinWidth="240" Binding="{Binding Path}" ElementStyle="{StaticResource Cell.Secondary}" Header="Item" />
              <DataGridTextColumn Width="*" MinWidth="240" Binding="{Binding Message}" ElementStyle="{StaticResource Cell.Secondary}" Header="What happened" />
              <DataGridTextColumn Width="200" MinWidth="120" Binding="{Binding Destination}" ElementStyle="{StaticResource Cell.Secondary}" Header="Where it went" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>
    </Grid>

    <!-- Quarantine -->
    <Grid Grid.Row="1" Visibility="{Binding ShowQuarantine, Converter={StaticResource BoolToVisibility}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Margin="0,0,0,8" Style="{StaticResource Typography.Body}" Text="{Binding QuarantineSummary}" TextWrapping="Wrap" />
      <Border Grid.Row="1" Padding="0" Style="{StaticResource Card}">
        <DataGrid AutomationProperties.Name="Items in quarantine"
                  ItemsSource="{Binding Quarantine}"
                  SelectedItem="{Binding SelectedItem}"
                  AutoGenerateColumns="False"
                  BorderThickness="0"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="False"
                  EnableRowVirtualization="True"
                  GridLinesVisibility="None"
                  HeadersVisibility="Column"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling">
          <DataGrid.Columns>
            <DataGridTemplateColumn Width="*" MinWidth="260" Header="Came from">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate DataType="{x:Type cleanup:QuarantineRowViewModel}">
                  <StackPanel VerticalAlignment="Center" ToolTip="{Binding HeldPath}">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock FontSize="11" Opacity="0.75" Text="{Binding OriginalPath}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Width="96" MinWidth="96" Binding="{Binding LogicalBytes, Converter={StaticResource ByteSize}}" ElementStyle="{StaticResource Cell.Numeric}" Header="Size" />
            <DataGridTextColumn Width="150" MinWidth="150" Binding="{Binding Quarantined, StringFormat=g}" ElementStyle="{StaticResource Cell.Secondary}" Header="Moved" />
            <DataGridTextColumn Width="*" MinWidth="200" Binding="{Binding Note}" ElementStyle="{StaticResource Cell.Secondary}" Header="Notes" />
            <DataGridTextColumn Width="170" MinWidth="130" Binding="{Binding IntegrityText}" ElementStyle="{StaticResource Cell.Secondary}" Header="Check" />
          </DataGrid.Columns>
        </DataGrid>
      </Border>
      <WrapPanel Grid.Row="2" Margin="0,12,0,0">
        <Button Margin="0,0,8,0" Command="{Binding RestoreCommand}" Content="Restore" Style="{StaticResource Button.Accent}" />
        <Button Margin="0,0,8,0" Command="{Binding RestoreToFolderCommand}" Content="Restore to a folder…" />
        <Button Margin="24,0,0,0" Command="{Binding DeleteCommand}" Content="Permanently delete" ToolTip="Deletes the selected item for good, after you confirm" />
      </WrapPanel>
    </Grid>

    <Border Grid.Row="1" MaxWidth="640" HorizontalAlignment="Left" VerticalAlignment="Top" Style="{StaticResource Banner.Warning}" Visibility="{Binding State, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Error}">
      <TextBlock Style="{StaticResource Typography.Body}" Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
    </Border>
  </Grid>
</UserControl>
