<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    High-contrast tokens map to the user's Windows contrast-theme colours. x:Static reads the colours
    when the dictionary loads; ThemeService reloads it whenever Windows contrast settings change.
    Status colours collapse to the text colour, so status must always also be conveyed by text or an
    icon (docs/07-ui-ux-design.md §7).
  -->

  <SolidColorBrush x:Key="Color.Background" Color="{x:Static SystemColors.WindowColor}" />
  <SolidColorBrush x:Key="Color.Surface" Color="{x:Static SystemColors.WindowColor}" />
  <SolidColorBrush x:Key="Color.SurfaceElevated" Color="{x:Static SystemColors.WindowColor}" />
  <SolidColorBrush x:Key="Color.SurfaceHover" Color="{x:Static SystemColors.HighlightColor}" />
  <SolidColorBrush x:Key="Color.SurfaceSelected" Color="{x:Static SystemColors.HighlightColor}" />
  <SolidColorBrush x:Key="Color.Border" Color="{x:Static SystemColors.WindowTextColor}" />
  <SolidColorBrush x:Key="Color.TextPrimary" Color="{x:Static SystemColors.WindowTextColor}" />
  <SolidColorBrush x:Key="Color.TextSecondary" Color="{x:Static SystemColors.WindowTextColor}" />
  <SolidColorBrush x:Key="Color.Accent" Color="{x:Static SystemColors.HighlightColor}" />
  <SolidColorBrush x:Key="Color.OnAccent" Color="{x:Static SystemColors.HighlightTextColor}" />
  <SolidColorBrush x:Key="Color.Success" Color="{x:Static SystemColors.WindowTextColor}" />
  <SolidColorBrush x:Key="Color.Warning" Color="{x:Static SystemColors.WindowTextColor}" />
  <SolidColorBrush x:Key="Color.Danger" Color="{x:Static SystemColors.WindowTextColor}" />
  <SolidColorBrush x:Key="Color.Info" Color="{x:Static SystemColors.WindowTextColor}" />
  <SolidColorBrush x:Key="Color.InfoBackground" Color="{x:Static SystemColors.WindowColor}" />
  <SolidColorBrush x:Key="Color.WarningBackground" Color="{x:Static SystemColors.WindowColor}" />
  <SolidColorBrush x:Key="Color.MeterTrack" Color="{x:Static SystemColors.WindowColor}" />
  <SolidColorBrush x:Key="Color.Folder" Color="{x:Static SystemColors.WindowTextColor}" />

</ResourceDictionary>
