<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:FreeAll.Desktop.ViewModels"
                    xmlns:index="clr-namespace:FreeAll.Desktop.ViewModels.Index"
             xmlns:residue="clr-namespace:FreeAll.Desktop.ViewModels.Residue"
             xmlns:duplicates="clr-namespace:FreeAll.Desktop.ViewModels.Duplicates"
             xmlns:cleanup="clr-namespace:FreeAll.Desktop.ViewModels.Cleanup"
                    xmlns:views="clr-namespace:FreeAll.Desktop.Views">

  <!-- Maps each page view model to its view. The shell's ContentControl picks the template by type. -->

  <DataTemplate DataType="{x:Type vm:OverviewViewModel}">
    <views:OverviewPage />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:DrivesViewModel}">
    <views:DrivesPage />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:WindowsStorageViewModel}">
    <views:WindowsStoragePage />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
    <views:SettingsPage />
  </DataTemplate>

  <DataTemplate DataType="{x:Type index:ExplorerViewModel}">
    <views:ExplorerPage />
  </DataTemplate>

  <DataTemplate DataType="{x:Type index:LargeFilesViewModel}">
    <views:LargeFilesPage />
  </DataTemplate>

  <DataTemplate DataType="{x:Type index:CategoriesViewModel}">
    <views:CategoriesPage />
  </DataTemplate>

  <DataTemplate DataType="{x:Type index:ScanHistoryViewModel}">
    <views:ScanHistoryPage />
  </DataTemplate>

  <DataTemplate DataType="{x:Type index:SearchViewModel}">
    <views:SearchPage />
  </DataTemplate>

  <DataTemplate DataType="{x:Type index:ReviewQueueViewModel}">
    <views:ReviewQueuePage />
  </DataTemplate>

  <DataTemplate DataType="{x:Type residue:ResidueViewModel}">
    <views:ResiduePage />
  </DataTemplate>

  <DataTemplate DataType="{x:Type residue:TemporaryFilesViewModel}">
    <views:TemporaryFilesPage />
  </DataTemplate>

  <DataTemplate DataType="{x:Type duplicates:DuplicatesViewModel}">
    <views:DuplicatesPage />
  </DataTemplate>

  <DataTemplate DataType="{x:Type cleanup:CleanupReviewViewModel}">
    <views:CleanupReviewPage />
  </DataTemplate>

  <DataTemplate DataType="{x:Type cleanup:ActivityViewModel}">
    <views:ActivityPage />
  </DataTemplate>

</ResourceDictionary>
