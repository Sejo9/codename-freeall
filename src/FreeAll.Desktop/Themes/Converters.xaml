<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:FreeAll.Desktop.Converters">

  <c:BoolToVisibilityConverter x:Key="BoolToVisibility" />
  <c:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
  <c:NullToVisibilityConverter x:Key="NullToVisibility" />
  <c:NullToVisibilityConverter x:Key="InverseNullToVisibility" Invert="True" />
  <c:EqualsToVisibilityConverter x:Key="EqualsToVisibility" />
  <c:ByteSizeConverter x:Key="ByteSize" />

</ResourceDictionary>
