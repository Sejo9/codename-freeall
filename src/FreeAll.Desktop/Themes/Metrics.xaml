<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- Theme-independent tokens: shape, spacing and typography (docs/07-ui-ux-design.md §3). -->

  <CornerRadius x:Key="Radius.Small">6</CornerRadius>
  <CornerRadius x:Key="Radius.Medium">8</CornerRadius>
  <CornerRadius x:Key="Radius.Large">10</CornerRadius>

  <sys:Double x:Key="Spacing.1">4</sys:Double>
  <sys:Double x:Key="Spacing.2">8</sys:Double>
  <sys:Double x:Key="Spacing.3">12</sys:Double>
  <sys:Double x:Key="Spacing.4">16</sys:Double>
  <sys:Double x:Key="Spacing.5">20</sys:Double>
  <sys:Double x:Key="Spacing.6">24</sys:Double>
  <sys:Double x:Key="Spacing.7">32</sys:Double>
  <sys:Double x:Key="Spacing.8">40</sys:Double>

  <Thickness x:Key="Thickness.Page">32,8,32,24</Thickness>
  <Thickness x:Key="Thickness.Card">16</Thickness>
  <Thickness x:Key="Thickness.SectionGap">0,0,0,24</Thickness>

  <sys:Double x:Key="Nav.ExpandedWidth">240</sys:Double>
  <sys:Double x:Key="Nav.CompactWidth">52</sys:Double>

  <FontFamily x:Key="Font.Text">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="Font.Display">Segoe UI Variable Display, Segoe UI</FontFamily>
  <FontFamily x:Key="Font.Monospace">Cascadia Mono, Consolas</FontFamily>
  <FontFamily x:Key="Font.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

  <Style x:Key="Typography.Display" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Color.TextPrimary}" />
  </Style>

  <Style x:Key="Typography.Heading" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Color.TextPrimary}" />
  </Style>

  <Style x:Key="Typography.Title" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Text}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Color.TextPrimary}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style x:Key="Typography.Body" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Text}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource Color.TextPrimary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="Typography.Caption" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Text}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Color.TextSecondary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- File sizes, counts and timestamps use tabular numerals so columns line up. -->
  <Style x:Key="Typography.Numeric" TargetType="TextBlock" BasedOn="{StaticResource Typography.Body}">
    <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    <Setter Property="TextWrapping" Value="NoWrap" />
  </Style>

  <!-- Paths, hashes, IDs and technical values only. -->
  <Style x:Key="Typography.Monospace" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Monospace}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Color.TextPrimary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="Typography.Icon" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Font.Icons}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="Foreground" Value="{DynamicResource Color.TextPrimary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

</ResourceDictionary>
